{
    "server_cmds": {
        "server_cmd_tp8": [
            ["python3 -m sglang.launch_server --trust-remote-code"],
            ["--model-path ${MiniMax-M2.5-W8A8-model-path}"],
            ["--disable-radix-cache --disable-chunked-prefix-cache"],
            ["--attention-backend flashinfer"],
            ["--tp 8"],
            ["--mem-fraction-static 0.90"],
            ["--quantization w8a8_int8"]
        ]
    },
    "benchmark_cmds": {
        "random": {
            "command_base": "python3 -m sglang.bench_serving --backend sglang --dataset-name random --random-range-ratio 1.0 --dataset-path ${random-dataset-path} ",
                "input_output_len": ["3072/1024"],
                "max_concurrency": ["1", "16", "32", "64", "128", "256"],
                "num_prompt_times": 5
        },
        "ceval": {
            "type": "ceval",
            "command_base": "python3  run_ceval_client.py --model ${MiniMax-M2.5-W8A8-model-path}  --test_jsonl ${ceval-dataset-path} --batch_size 64 --timeout 600 "
        },
        "mmlu": {
            "type": "mmlu",
            "environment": ["mmlu_envs"],
            "command_base": "python3 bench_sglang.py --data_dir ${mmlu-dataset-path} --nsub 60"
        }
    },
    "tasks": {
        "MiniMax-M2.5-W8A8-TP8": {
            "launch_server": "server_cmd_tp8",
            "benchmark": "random;ceval;mmlu"
        }
    }
}
