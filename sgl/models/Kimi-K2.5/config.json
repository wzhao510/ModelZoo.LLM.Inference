{
    "server_cmds": {
        "server_cmd_tp2dp8": [
            ["python3 -m sglang.launch_server --trust-remote-code"],
            ["--model-path ${Kimi-K2.5-model-path}"],
            ["--disable-radix-cache --disable-chunked-prefix-cache"],
            ["--attention-backend flashinfer"],
            ["--tp 16 --dp 8 --enable-dp-attention"],
            ["--mem-fraction-static 0.87"]
        ]            
    },

    "benchmark_cmds": {
        "random": {
            "command_base": "python3 -m sglang.bench_serving --backend sglang --dataset-name random --random-range-ratio 1.0 --dataset-path ${random-dataset-path} ",
                "input_output_len": ["3072/1024"],
                "max_concurrency": ["1", "16", "32", "64", "128", "256"],
                "num_prompt_times": 5
        },
        "ceval": {
            "type": "ceval",
            "command_base": "python3  run_ceval_client.py --model ${Kimi-K2.5-model-path}  --test_jsonl ${ceval-dataset-path} --batch_size 64 --timeout 300 "
        },
        "mmlu": {
            "type": "mmlu",
            "environment": ["mmlu_envs"],
            "command_base": "python3 bench_sglang.py --data_dir ${mmlu-dataset-path} --nsub 60"
        }
    },
    "tasks": {
        "Kimi-K2.5-TP4DP4" : {
            "launch_server": "server_cmd_tp2dp8",
            "benchmark": "random;ceval;mmlu",
            "environment": ["default_envs","ENABLE_MCTLASS_FUSED_MOE_PYTHON_API=0","ENABLE_MACA_SGLANG_FUSED_MOE_MCTLASS_W4A16=0"]
        }
    }
}
