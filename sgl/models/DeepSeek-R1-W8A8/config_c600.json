{
    "server_cmds": {
        "server_cmd_dp8tp2": [
            ["python3 -m sglang.launch_server --trust-remote-code"],
            ["--model-path ${DeepSeek-R1-W8A8-model-path}"],
            ["--disable-radix-cache"],
            ["--attention-backend flashinfer"],
            ["--mem-frac 0.80"],
            ["--tp 16 --dp 8 --enable-dp-attention --enable-dp-lm-head"]
        ],
        "server_cmd_tp16": [
            ["python3 -m sglang.launch_server --trust-remote-code"],
            ["--model-path ${DeepSeek-R1-W8A8-model-path}"],
            ["--disable-radix-cache"],
            ["--attention-backend flashinfer"],
            ["--mem-frac 0.82"],
            ["--cuda-graph-max-bs 256"],
            ["--tp 16"]
        ],
        "server_cmd_tp4dp4": [
            ["python3 -m sglang.launch_server --trust-remote-code"],
            ["--model-path ${DeepSeek-R1-W8A8-model-path}"],
            ["--disable-radix-cache"],
            ["--attention-backend flashinfer"],
            ["--mem-frac 0.80"],
            ["--tp 16 --dp 4 --enable-dp-attention --enable-dp-lm-head"]
        ],
        "server_cmd_dp8tp2mtp3": [
            ["python3 -m sglang.launch_server --trust-remote-code"],
            ["--model-path ${DeepSeek-R1-W8A8-model-path}"],
            ["--disable-radix-cache"],
            ["--attention-backend flashinfer"],
            ["--mem-frac 0.80"],
            ["--tp 16 --dp 8 --enable-dp-attention --enable-dp-lm-head"],
            [" --speculative-algorithm NEXTN --speculative-draft-model-path ${DeepSeek-R1-W8A8-draft-model-path} --speculative-num-steps 2 --speculative-eagle-topk 1 --speculative-num-draft-tokens 3 --quantization w8a8_int8"]
        ],
        "server_cmd_tp16mtp4": [
            ["python3 -m sglang.launch_server --trust-remote-code"],
            ["--model-path ${DeepSeek-R1-W8A8-model-path}"],
            ["--disable-radix-cache"],
            ["--attention-backend flashinfer"],
            ["--mem-frac 0.82"],
            ["--cuda-graph-max-bs 256"],
            ["--tp 16"],
            [" --speculative-algorithm NEXTN --speculative-draft-model-path ${DeepSeek-R1-W8A8-draft-model-path} --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --quantization w8a8_int8"]
        ],
        "server_cmd_tp4dp4mtp3": [
            ["python3 -m sglang.launch_server --trust-remote-code"],
            ["--model-path ${DeepSeek-R1-W8A8-model-path}"],
            ["--disable-radix-cache"],
            ["--attention-backend flashinfer"],
            ["--mem-frac 0.80"],
            ["--tp 16 --dp 4 --enable-dp-attention --enable-dp-lm-head"],
            [" --speculative-algorithm NEXTN --speculative-draft-model-path ${DeepSeek-R1-W8A8-draft-model-path} --speculative-num-steps 2 --speculative-eagle-topk 1 --speculative-num-draft-tokens 3 --quantization w8a8_int8"]
        ]
    },
    "benchmark_cmds": {
        "random": {
            "command_base": "python3 -m sglang.bench_serving --backend sglang --dataset-name random --random-range-ratio 1.0 --dataset-path ${random-dataset-path} ",
            "input_output_len": ["3072/1024"],
            "max_concurrency": ["1", "16", "32", "64", "128"],
            "num_prompt_times": 5
        },
        "ceval": {
            "type": "ceval",
            "command_base": "python3  run_ceval_client.py --model ${DeepSeek-R1-W8A8-model-path} --test_jsonl ${ceval-data-path} --batch_size 64 --timeout 1800 "
        },
        "mmlu": {
            "type": "mmlu",
            "environment": ["mmlu_envs"],
            "command_base": "python3 bench_sglang.py --data_dir ${mmlu-data-path} --nsub 60"
        }
    },
    "tasks": {
        "DeepSeek-R1-W8A8-0528-dp8tp2mtp3": {
            "launch_server": "server_cmd_dp8tp2mtp3",
            "benchmark": "random;ceval;mmlu"
        },
        "DeepSeek-R1-W8A8-0528-tp16mtp4" : {
            "launch_server": "server_cmd_tp16mtp4",
            "benchmark": "random;ceval;mmlu"
        },
        "DeepSeek-R1-W8A8-0528-tp4dp4mtp3": {
            "launch_server": "server_cmd_tp4dp4mtp3",
            "benchmark": "random;ceval;mmlu"
        },
        "DeepSeek-R1-W8A8-0528-dp8tp2": {
            "launch_server": "server_cmd_dp8tp2",
            "benchmark": "random;ceval;mmlu"
        },
        "DeepSeek-R1-W8A8-0528-tp16" : {
            "launch_server": "server_cmd_tp16",
            "benchmark": "random;ceval;mmlu"
        },
        "DeepSeek-R1-W8A8-0528-tp4dp4": {
            "launch_server": "server_cmd_tp4dp4",
            "benchmark": "random;ceval;mmlu"
        }
    }
}
